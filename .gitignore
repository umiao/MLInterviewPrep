# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example
.secrets/
*.pem
*.key
*.secret
*.token
credentials*
*.cookie

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.eggs/
dist/
build/

# Data (runtime data not tracked)
data/*
# ...except authoring-source inventories that drive idempotent seed scripts
!data/ml_fundamentals_inventory.yaml

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Claude autonomous mode state (ephemeral, per-session)
.claude/session_state.json
.claude/checkpoint.json
.claude/state.json
.claude/last_*_pass
.claude/autonomous.lock
.claude/tasks.db
.claude/events.jsonl
.claude/events.jsonl.*
.meta_mlsd_log_path.txt

# Word / temp files
*.docx
~$*
*.tmp

# Temp artifacts from content seeding scripts
_temp*.json
_temp*.py

# Misc
*.log
/tmp

# Crash dumps
*.stackdump

# Logs and scratch artifacts (matches root workspace convention)
logs/

# Node modules (root-level too -- frontend has its own .gitignore for src/frontend/node_modules)
node_modules/

# Ad-hoc DB exports at repo root (use scripts/, not loose .csv files)
/*.csv

# Runtime databases (root + backend + accidental aliases)
interview_prep.db
problems.db
dev.db
mle_prep.db
mli*.db
mlprep.db
src/backend/*.db

# Task DB migration backups
.claude/tasks.db.bak*

# Ad-hoc task exports (use task_db.py, not file dumps)
tasks_dump.json
tasks_temp.*

# Claude worktrees
.claude/worktrees/
docs/staging/generated/

# --- Runtime logs (WSH-C1) ------------------------------
# Never commit per-run log spew. Hand-authored artifacts under logs/
# (drafts, diffs, screenshots) are intentionally tracked and unaffected.
data/logs/
logs/wrapper-stats.jsonl
logs/autonomous*.jsonl
